# Backend API base URL (no trailing slash). Required for login and all API calls.
# Local: http://localhost:8000
# Vercel/Production: https://api.v2.imfbxd.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to skip login and open admin panel as "Dev Admin" (no backend).
# Set to "false" when using real backend and login.
NEXT_PUBLIC_SKIP_AUTH=false
